<% content_for :title, "Historia" %>

<% prev_month = @month.prev_month %>
<% next_month = @month.next_month %>

<div class="flex items-center justify-between">
  <div>
    <p class="text-xs uppercase tracking-[0.18em] text-ink-400">Historia</p>
    <h1 class="text-2xl font-semibold tracking-tight text-ink-100"><%= format_month(@month) %></h1>
  </div>
  <div class="flex items-center gap-1">
    <%= link_to history_path(month: prev_month.strftime("%Y-%m")), class: "btn-ghost", "aria-label": "Mes previo" do %>
      ‹
    <% end %>
    <%= link_to "Hoy", history_path, class: "btn-ghost" unless @month == Date.current.beginning_of_month %>
    <%= link_to history_path(month: next_month.strftime("%Y-%m")), class: "btn-ghost", "aria-label": "Mes siguiente" do %>
      ›
    <% end %>
  </div>
</div>

<div class="mt-8 grid gap-10 lg:grid-cols-2">
  <section>
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wider text-ink-400">Puntuación diaria</h2>
    <%= render "calendar",
               month: @month,
               cell_class_fn: ->(date, in_month) {
                 note = @notes_by_date[date]
                 score_cell_classes(note&.overall_score, in_month: in_month)
               },
               cell_label_fn: ->(date) {
                 note = @notes_by_date[date]
                 note&.overall_score ? note.overall_score.to_s : ""
               } %>
    <div class="mt-3 flex items-center gap-3 text-[10px] text-ink-500">
      <span>Menos</span>
      <span class="h-3 w-5 rounded bg-red-500/60"></span>
      <span class="h-3 w-5 rounded bg-red-500/30"></span>
      <span class="h-3 w-5 rounded bg-amber-500/40"></span>
      <span class="h-3 w-5 rounded bg-accent-500/40"></span>
      <span class="h-3 w-5 rounded bg-accent-500/80"></span>
      <span>Más</span>
    </div>
  </section>

  <section>
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wider text-ink-400">Cumplimiento</h2>
    <%= render "calendar",
               month: @month,
               cell_class_fn: ->(date, in_month) {
                 ratio = @compliance_by_date.dig(date, :ratio)
                 compliance_cell_classes(ratio, in_month: in_month)
               },
               cell_label_fn: ->(date) {
                 data = @compliance_by_date[date]
                 data && data[:total].positive? ? "#{data[:filled]}/#{data[:total]}" : ""
               } %>
    <div class="mt-3 flex items-center gap-3 text-[10px] text-ink-500">
      <span>&lt;50%</span>
      <span class="h-3 w-5 rounded bg-red-500/50"></span>
      <span class="h-3 w-5 rounded bg-amber-500/40"></span>
      <span class="h-3 w-5 rounded bg-accent-500/70"></span>
      <span>&gt;80%</span>
    </div>
  </section>
</div>
