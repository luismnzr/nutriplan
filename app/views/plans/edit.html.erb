<% content_for :title, @plan.name %>

<div class="flex items-center justify-between">
  <div>
    <p class="text-xs uppercase tracking-[0.18em] text-ink-400">
      <%= I18n.l(@plan.start_date, format: :short) %> — <%= I18n.l(@plan.end_date, format: :short) %>
    </p>
    <h1 class="text-2xl font-semibold tracking-tight text-ink-100"><%= @plan.name %></h1>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to "Ver", plan_path(@plan), class: "btn-ghost" %>
    <%= button_to "Eliminar", plan_path(@plan), method: :delete,
                  form: { data: { turbo_confirm: "¿Eliminar este plan y todo su contenido?" } },
                  class: "btn-ghost text-red-400 hover:bg-red-500/10" %>
  </div>
</div>

<details class="mt-6 rounded-md border border-ink-800 bg-ink-900/40 open:bg-ink-900/60">
  <summary class="cursor-pointer select-none px-4 py-3 text-sm text-ink-300">Editar metadata del plan</summary>
  <div class="border-t border-ink-800 px-4 pb-4">
    <%= render "form", plan: @plan %>
  </div>
</details>

<section class="mt-8">
  <%= render "grid", plan: @plan %>
</section>
