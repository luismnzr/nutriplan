<% content_for :title, @plan.name %>

<div class="flex items-center justify-between">
  <div>
    <p class="text-xs uppercase tracking-[0.18em] text-ink-400">
      <%= I18n.l(@plan.start_date, format: :short) %> — <%= I18n.l(@plan.end_date, format: :short) %>
    </p>
    <h1 class="text-2xl font-semibold tracking-tight text-ink-100"><%= @plan.name %></h1>
  </div>
  <%= link_to "Editar", edit_plan_path(@plan), class: "btn-ghost" %>
</div>

<p class="mt-6 text-sm text-ink-400">Vista solo lectura con indicadores de cumplimiento — sub-fase 4.</p>
